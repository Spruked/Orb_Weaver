<?xml version="1.0"?>
<rdf:RDF xmlns="http://spruked.com/orbweaver/movement#"
     xml:base="http://spruked.com/orbweaver/movement"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://spruked.com/orbweaver/movement"/>

    <!-- ===================== Core classes ===================== -->

    <owl:Class rdf:about="#MovementIntent"/>
    <owl:Class rdf:about="#Present"><rdfs:subClassOf rdf:resource="#MovementIntent"/></owl:Class>
    <owl:Class rdf:about="#Listen"><rdfs:subClassOf rdf:resource="#MovementIntent"/></owl:Class>
    <owl:Class rdf:about="#Guide"><rdfs:subClassOf rdf:resource="#MovementIntent"/></owl:Class>
    <owl:Class rdf:about="#Inspect"><rdfs:subClassOf rdf:resource="#MovementIntent"/></owl:Class>
    <owl:Class rdf:about="#Avoid"><rdfs:subClassOf rdf:resource="#MovementIntent"/></owl:Class>
    <owl:Class rdf:about="#Transition"><rdfs:subClassOf rdf:resource="#MovementIntent"/></owl:Class>
    <owl:Class rdf:about="#Rest"><rdfs:subClassOf rdf:resource="#MovementIntent"/></owl:Class>
    <owl:Class rdf:about="#Summon"><rdfs:subClassOf rdf:resource="#MovementIntent"/></owl:Class>

    <owl:Class rdf:about="#Zone"/>
    <owl:Class rdf:about="#ViewportCenter"><rdfs:subClassOf rdf:resource="#Zone"/></owl:Class>
    <owl:Class rdf:about="#UpperRightRest"><rdfs:subClassOf rdf:resource="#Zone"/></owl:Class>
    <owl:Class rdf:about="#ContentLeft"><rdfs:subClassOf rdf:resource="#Zone"/></owl:Class>
    <owl:Class rdf:about="#ContentRight"><rdfs:subClassOf rdf:resource="#Zone"/></owl:Class>
    <owl:Class rdf:about="#BottomRightRestZone"><rdfs:subClassOf rdf:resource="#Zone"/></owl:Class>
    <owl:Class rdf:about="#SidebarOccupiedZone">
        <rdfs:subClassOf rdf:resource="#Zone"/>
        <owl:disjointWith rdf:resource="#ContentLeft"/>
    </owl:Class>

    <owl:Class rdf:about="#PointOfInterest"/>

    <owl:Class rdf:about="#Urgency">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <owl:Thing rdf:about="#Calm"/>
                    <owl:Thing rdf:about="#Normal"/>
                    <owl:Thing rdf:about="#Immediate"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#ApproachBehavior">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <owl:Thing rdf:about="#DecelerateOnArrive"/>
                    <owl:Thing rdf:about="#HoldSteady"/>
                    <owl:Thing rdf:about="#CircleAndPresent"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ===================== Properties ===================== -->

    <owl:ObjectProperty rdf:about="#targetsZone">
        <rdfs:domain rdf:resource="#MovementIntent"/>
        <rdfs:range rdf:resource="#Zone"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#targetsPOI">
        <rdfs:domain rdf:resource="#MovementIntent"/>
        <rdfs:range rdf:resource="#PointOfInterest"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasUrgency">
        <rdfs:range rdf:resource="#Urgency"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasApproachBehavior">
        <rdfs:range rdf:resource="#ApproachBehavior"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="#hasTargetId">
        <rdfs:domain rdf:resource="#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#onRoute">
        <rdfs:domain rdf:resource="#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#worldStateSequence">
        <rdfs:comment>Optimistic-concurrency counter. HAL must reject any
            command whose sequence does not match the currently loaded
            precompiled map before executing physical motion.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <!-- ===================== Hard constraint: never rest bottom-right ===================== -->
    <owl:Class rdf:about="#Rest">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#targetsZone"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:complementOf rdf:resource="#BottomRightRestZone"/>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ===================== Example individuals ===================== -->

    <owl:NamedIndividual rdf:about="#poi_pricing_card">
        <rdf:type rdf:resource="#PointOfInterest"/>
        <hasTargetId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_4a3259cd45ff</hasTargetId>
        <onRoute rdf:datatype="http://www.w3.org/2001/XMLSchema#string">/pricing</onRoute>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#poi_pops_declaration">
        <rdf:type rdf:resource="#PointOfInterest"/>
        <hasTargetId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_pops_access_panel</hasTargetId>
        <onRoute rdf:datatype="http://www.w3.org/2001/XMLSchema#string">/pops</onRoute>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Calm"/>
    <owl:NamedIndividual rdf:about="#Normal"/>
    <owl:NamedIndividual rdf:about="#Immediate"/>
    <owl:NamedIndividual rdf:about="#DecelerateOnArrive"/>
    <owl:NamedIndividual rdf:about="#HoldSteady"/>
    <owl:NamedIndividual rdf:about="#CircleAndPresent"/>

</rdf:RDF>
