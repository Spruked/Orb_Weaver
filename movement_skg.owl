<?xml version="1.0"?>
<rdf:RDF xmlns="http://spruked.com/orbweaver/movement#"
     xml:base="http://spruked.com/orbweaver/movement"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">

    <owl:Ontology rdf:about="http://spruked.com/orbweaver/movement">
        <rdfs:comment>Generic movement vocabulary and hard constraints for the
            ORB motion runtime. Schema only: no site data, no selectors, no
            product names. Deployment data (real targets and routes) is
            injected at runtime and never lives in this file.
            Constraints marked ENFORCE must also exist as runtime code with a
            test; an ontology statement alone enforces nothing.</rdfs:comment>
    </owl:Ontology>

    <!-- ===================== Movement intents ===================== -->

    <owl:AnnotationProperty rdf:about="#proposedSkgIntents">
        <rdfs:comment>PROPOSED mapping from ontology intent to OrbitalBehaviorSKG
            intents. Owner must confirm or edit; not authoritative.</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:Class rdf:about="#MovementIntent"/>
    <owl:Class rdf:about="#Present"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>approach orbit point</proposedSkgIntents></owl:Class>
    <owl:Class rdf:about="#Listen"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>hold</proposedSkgIntents></owl:Class>
    <owl:Class rdf:about="#Guide"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>approach point ping</proposedSkgIntents></owl:Class>
    <owl:Class rdf:about="#Inspect"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>approach orbit</proposedSkgIntents></owl:Class>
    <owl:Class rdf:about="#Avoid"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>retreat</proposedSkgIntents></owl:Class>
    <owl:Class rdf:about="#Transition"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>approach</proposedSkgIntents></owl:Class>
    <owl:Class rdf:about="#Summon"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>approach</proposedSkgIntents></owl:Class>
    <owl:Class rdf:about="#Ambient"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>idle</proposedSkgIntents></owl:Class>
    <owl:Class rdf:about="#Dormant"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>idle</proposedSkgIntents></owl:Class>
    <owl:Class rdf:about="#Awaken"><rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>idle</proposedSkgIntents></owl:Class>

    <!-- ENFORCE: Rest never targets the bottom-right zone. Runtime must apply
         this as a hard exclusion in the safe-pose selector. -->
    <owl:Class rdf:about="#Rest">
        <rdfs:subClassOf rdf:resource="#MovementIntent"/>
        <proposedSkgIntents>idle hold</proposedSkgIntents>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#targetsZone"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:complementOf rdf:resource="#BottomRightRestZone"/>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ===================== Zones and movement fields ===================== -->
    <!-- Zones are labels resolved from live geometry, never fixed screen
         coordinates. A zone name is a soft preference unless a constraint
         above says otherwise. -->

    <owl:Class rdf:about="#Zone"/>
    <owl:Class rdf:about="#ViewportCenter"><rdfs:subClassOf rdf:resource="#Zone"/></owl:Class>
    <owl:Class rdf:about="#UpperRightRest">
        <rdfs:subClassOf rdf:resource="#Zone"/>
        <owl:disjointWith rdf:resource="#BottomRightRestZone"/>
    </owl:Class>
    <owl:Class rdf:about="#BottomRightRestZone"><rdfs:subClassOf rdf:resource="#Zone"/></owl:Class>
    <owl:Class rdf:about="#ContentLeft">
        <rdfs:subClassOf rdf:resource="#Zone"/>
        <owl:disjointWith rdf:resource="#ContentRight"/>
    </owl:Class>
    <owl:Class rdf:about="#ContentRight"><rdfs:subClassOf rdf:resource="#Zone"/></owl:Class>
    <owl:Class rdf:about="#SidebarOccupiedZone">
        <rdfs:subClassOf rdf:resource="#Zone"/>
        <owl:disjointWith rdf:resource="#ContentLeft"/>
    </owl:Class>

    <owl:Class rdf:about="#MovementField"/>
    <owl:Class rdf:about="#FullViewport"><rdfs:subClassOf rdf:resource="#MovementField"/></owl:Class>
    <owl:Class rdf:about="#SpeechSafeZone"><rdfs:subClassOf rdf:resource="#MovementField"/></owl:Class>
    <owl:Class rdf:about="#DynamicOccupiedRegion"><rdfs:subClassOf rdf:resource="#MovementField"/></owl:Class>
    <owl:Class rdf:about="#ActiveControlRegion"><rdfs:subClassOf rdf:resource="#DynamicOccupiedRegion"/></owl:Class>
    <owl:Class rdf:about="#TargetPresentationRegion"><rdfs:subClassOf rdf:resource="#DynamicOccupiedRegion"/></owl:Class>

    <owl:Class rdf:about="#PointOfInterest"/>

    <!-- ===================== Urgency, speed, approach ===================== -->

    <owl:Class rdf:about="#Urgency">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <owl:Thing rdf:about="#Calm"/>
                    <owl:Thing rdf:about="#Normal"/>
                    <owl:Thing rdf:about="#Immediate"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- Doctrine speed tiers. Relationship to Urgency is for the owner to
         settle. ENFORCE: GLIDE is the default; BRISK only on explicit visitor
         impatience; URGENT only for genuine runtime failure. -->
    <owl:Class rdf:about="#PointSpeed">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <owl:Thing rdf:about="#Glide"/>
                    <owl:Thing rdf:about="#Brisk"/>
                    <owl:Thing rdf:about="#Urgent"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#ApproachBehavior">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <owl:Thing rdf:about="#DecelerateOnArrive"/>
                    <owl:Thing rdf:about="#HoldSteady"/>
                    <owl:Thing rdf:about="#CircleAndPresent"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <!-- ===================== Pointing vocabulary ===================== -->

    <owl:Class rdf:about="#PointStage">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <owl:Thing rdf:about="#StageAcquire"/>
                    <owl:Thing rdf:about="#StageApproach"/>
                    <owl:Thing rdf:about="#StageArrive"/>
                    <owl:Thing rdf:about="#StagePoint"/>
                    <owl:Thing rdf:about="#StagePing"/>
                    <owl:Thing rdf:about="#StageRelease"/>
                    <owl:Thing rdf:about="#StageTargetLost"/>
                    <owl:Thing rdf:about="#StageBowOut"/>
                    <owl:Thing rdf:about="#StageRefused"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
    </owl:Class>

    <owl:Class rdf:about="#PointSession">
        <rdfs:comment>One gated pointing run toward a single target. While
            active it outranks all behavioral intents (follow, orbit,
            ambient).</rdfs:comment>
    </owl:Class>

    <!-- ENFORCE: a Ping is an output of a session, never a free command.
         It requires a verified target, arrival in stance, and fresh geometry,
         all true on the emitting tick. A lost or refused target never pings. -->
    <owl:Class rdf:about="#PingEvent">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#targetVerified"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#arrivedInStance"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#geometryFresh"/>
                <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ===================== Properties ===================== -->

    <owl:ObjectProperty rdf:about="#targetsZone">
        <rdfs:domain rdf:resource="#MovementIntent"/>
        <rdfs:range rdf:resource="#Zone"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#targetsPOI">
        <rdfs:domain rdf:resource="#MovementIntent"/>
        <rdfs:range rdf:resource="#PointOfInterest"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasUrgency">
        <rdfs:domain rdf:resource="#MovementIntent"/>
        <rdfs:range rdf:resource="#Urgency"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasApproachBehavior">
        <rdfs:domain rdf:resource="#MovementIntent"/>
        <rdfs:range rdf:resource="#ApproachBehavior"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasSpeed">
        <rdfs:domain rdf:resource="#PointSession"/>
        <rdfs:range rdf:resource="#PointSpeed"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasStage">
        <rdfs:domain rdf:resource="#PointSession"/>
        <rdfs:range rdf:resource="#PointStage"/>
    </owl:ObjectProperty>

    <owl:DatatypeProperty rdf:about="#hasTargetId">
        <rdfs:domain rdf:resource="#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#onRoute">
        <rdfs:domain rdf:resource="#PointOfInterest"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#worldStateSequence">
        <rdfs:comment>Optimistic-concurrency counter. HAL must reject any
            command whose sequence does not match the currently loaded
            precompiled map before executing physical motion.</rdfs:comment>
        <rdfs:domain rdf:resource="#MovementIntent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#targetVerified">
        <rdfs:comment>True only when the host authority check passed on this
            tick. Absence of a verifier is false.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#arrivedInStance">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#geometryFresh">
        <rdfs:comment>False after any scroll or resize until the host pushes
            re-measured target geometry.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#speechPresentationFullyVisible">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#orbFullyVisible">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    <owl:DatatypeProperty rdf:about="#visitorInactivitySeconds">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <!-- ===================== Named individuals ===================== -->

    <owl:NamedIndividual rdf:about="#Calm"/>
    <owl:NamedIndividual rdf:about="#Normal"/>
    <owl:NamedIndividual rdf:about="#Immediate"/>
    <owl:NamedIndividual rdf:about="#Glide"/>
    <owl:NamedIndividual rdf:about="#Brisk"/>
    <owl:NamedIndividual rdf:about="#Urgent"/>
    <owl:NamedIndividual rdf:about="#DecelerateOnArrive"/>
    <owl:NamedIndividual rdf:about="#HoldSteady"/>
    <owl:NamedIndividual rdf:about="#CircleAndPresent"/>
    <owl:NamedIndividual rdf:about="#StageAcquire"/>
    <owl:NamedIndividual rdf:about="#StageApproach"/>
    <owl:NamedIndividual rdf:about="#StageArrive"/>
    <owl:NamedIndividual rdf:about="#StagePoint"/>
    <owl:NamedIndividual rdf:about="#StagePing"/>
    <owl:NamedIndividual rdf:about="#StageRelease"/>
    <owl:NamedIndividual rdf:about="#StageTargetLost"/>
    <owl:NamedIndividual rdf:about="#StageBowOut"/>
    <owl:NamedIndividual rdf:about="#StageRefused"/>

    <!-- Generic example only. Real targets and routes are deployment data. -->
    <owl:NamedIndividual rdf:about="#poi_example">
        <rdf:type rdf:resource="#PointOfInterest"/>
        <hasTargetId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">target_example_001</hasTargetId>
        <onRoute rdf:datatype="http://www.w3.org/2001/XMLSchema#string">/example-route</onRoute>
    </owl:NamedIndividual>

</rdf:RDF>
