{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orb_weaver.website_orb.qa.v1",
  "title": "Website ORB Verified QA v1",
  "type": "object",
  "required": ["schema", "site_id", "domain", "generated_at", "compiler_version", "entries"],
  "properties": {
    "schema": {"const": "orb_weaver.website_orb.qa.v1"},
    "site_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "compiler_version": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["qa_id", "question", "answer", "source_url", "route", "source_evidence_ids", "verified", "confidence", "content_hash"],
        "properties": {
          "qa_id": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}},
          "route": {"type": "string"},
          "source_url": {"type": "string", "format": "uri"},
          "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "pointer_target_id": {"type": ["string", "null"]},
          "verified": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "content_hash": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
