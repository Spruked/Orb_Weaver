{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orb_weaver.website_orb.pointer_correspondence.v1",
  "title": "Website ORB Pointer Correspondence v1",
  "type": "object",
  "required": ["schema", "site_id", "domain", "generated_at", "compiler_version", "records"],
  "properties": {
    "schema": {"const": "orb_weaver.website_orb.pointer_correspondence.v1"},
    "site_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "compiler_version": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["correspondence_id", "entity_id", "route", "pointer_target_id", "source_url", "allowed_actions", "verified", "confidence", "content_hash"],
        "properties": {
          "correspondence_id": {"type": "string", "minLength": 1},
          "entity_id": {"type": "string", "minLength": 1},
          "route": {"type": "string"},
          "pointer_target_id": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "uri"},
          "selector": {"type": ["string", "null"]},
          "semantic_label": {"type": ["string", "null"]},
          "intent_aliases": {"type": "array", "items": {"type": "string"}},
          "allowed_actions": {
            "type": "array",
            "items": {"enum": ["point", "highlight", "scroll", "focus", "click", "navigate", "submit"]}
          },
          "verified": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "content_hash": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
