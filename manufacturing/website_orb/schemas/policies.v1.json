{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orb_weaver.website_orb.policies.v1",
  "title": "Website ORB Policies v1",
  "type": "object",
  "required": ["schema", "site_id", "domain", "generated_at", "compiler_version", "rules"],
  "properties": {
    "schema": {"const": "orb_weaver.website_orb.policies.v1"},
    "site_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "compiler_version": {"type": "string", "minLength": 1},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["policy_id", "category", "title", "text", "source_url", "route", "source_evidence_ids", "owner_approved", "verified", "content_hash"],
        "properties": {
          "policy_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "route": {"type": "string"},
          "source_url": {"type": "string", "format": "uri"},
          "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "effective_date": {"type": ["string", "null"]},
          "owner_approved": {"type": "boolean"},
          "verified": {"type": "boolean"},
          "content_hash": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
