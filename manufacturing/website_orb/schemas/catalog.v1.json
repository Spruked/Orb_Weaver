{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orb_weaver.website_orb.catalog.v1",
  "title": "Website ORB Catalog v1",
  "type": "object",
  "required": ["schema", "site_id", "domain", "generated_at", "compiler_version", "entries"],
  "properties": {
    "schema": {"const": "orb_weaver.website_orb.catalog.v1"},
    "site_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "compiler_version": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "entity_type", "name", "source_url", "route", "source_evidence_ids", "verified", "confidence", "content_hash"],
        "properties": {
          "entity_id": {"type": "string", "minLength": 1},
          "entity_type": {"enum": ["product", "service", "plan", "fee", "membership", "other"]},
          "name": {"type": "string", "minLength": 1},
          "description": {"type": ["string", "null"]},
          "sku": {"type": ["string", "null"]},
          "category": {"type": ["string", "null"]},
          "price": {
            "type": ["object", "null"],
            "properties": {
              "amount": {"type": ["number", "null"]},
              "currency": {"type": ["string", "null"]},
              "display_text": {"type": ["string", "null"]},
              "min_amount": {"type": ["number", "null"]},
              "max_amount": {"type": ["number", "null"]},
              "billing_period": {"type": ["string", "null"]}
            },
            "additionalProperties": false
          },
          "availability": {"type": ["string", "boolean", "null"]},
          "route": {"type": "string"},
          "source_url": {"type": "string", "format": "uri"},
          "source_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "pointer_target_id": {"type": ["string", "null"]},
          "verified": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "content_hash": {"type": "string", "minLength": 1},
          "attributes": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
