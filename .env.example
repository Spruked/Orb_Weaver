# Application
APP_NAME=Orb Weaver - Website ORB Intelligence Engine
DEBUG=True
VERSION=1.0.0
SECRET_KEY=change-this-in-production
ADMIN_TOKEN=change-this-local-admin-token
PUBLIC_BASE_URL=https://orbweaver.spruked.com
REACT_APP_STUDIO_MARKETPLACE_URL=https://marketplace.orbweaver.spruked.com

# Canonical repository vault
# All persistent and runtime storage resolves under this one root.
ORB_WEAVER_VAULT_ROOT=../vault_system
# Legacy compatibility only; keep aligned with the canonical vault.
ORB_WEAVER_SUBSTRATE_ROOT=../vault_system

# Database
DATABASE_URL=sqlite:///../vault_system/databases/orb_weaver.db
REDIS_URL=redis://redis:6379/0

# Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2026-02-25.clover
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.paypal.com

# Google Analytics 4
GA4_PROPERTY_ID=your-ga4-property-id
GA4_CREDENTIALS_PATH=./ga4-credentials.json

# Crawler Settings
CRAWL_MAX_PAGES=1000
CRAWL_DELAY=1.0
CRAWL_TIMEOUT=30
CRAWL_USER_AGENT=Orb-Weaver/1.0
CRAWL_RESPECT_ROBOTS=True
CRAWL_MAX_DEPTH=5

# Local Website ORB cognition (Ollama)
LOCAL_LLM_URL=http://127.0.0.1:11434/api/generate
LOCAL_LLM_MODEL=qwen2.5:1.5b-instruct
LOCAL_LLM_TIMEOUT_SECONDS=60
LOCAL_LLM_KEEP_ALIVE=30m
LOCAL_LLM_NUM_CTX=512
LOCAL_LLM_NUM_PREDICT=32
LOCAL_LLM_TEMPERATURE=0.35

FASTER_WHISPER_STT_URL=http://127.0.0.1:9000/stt
ORB_ASSISTANT_ROOT=../Orb_Assistant
ORB_TTS_CACHE_DIR=../vault_system/runtime/tts_cache
ORB_TTS_TIMEOUT_SECONDS=45
ORB_TTS_QWEN_TIMEOUT_SECONDS=220
ORB_TTS_QWEN_URL=http://127.0.0.1:9880/speak
ORB_TTS_QWEN_API_KEY=
ORB_TTS_QWEN_MODEL=qwen-tts
ORB_TTS_QWEN_VOICE=cali_voice_profile
ORB_TTS_QWEN_FORMAT=wav
ORB_TTS_QWEN_PAYLOAD_MODE=qwen-voice-clone
ORB_TTS_KOKORO_URL=http://127.0.0.1:8880/speak
ORB_TTS_KOKORO_API_KEY=
ORB_TTS_KOKORO_MODEL=kokoro
ORB_TTS_KOKORO_VOICE=am_michael
ORB_TTS_KOKORO_FORMAT=wav
ORB_TTS_KOKORO_SPEED=1.05
ORB_TTS_KOKORO_PAYLOAD_MODE=kokoro-direct

# Browser review runtime output
CHROME_DEVTOOLS_OUTPUT_ROOT=../vault_system/runtime/browser_reviews

# ORB Desktop MCP relay
# Keep Orb Weaver's MCP server copy here. The desktop ORB may keep its own
# R-drive copy, but the Orb Weaver relay prefers this repo-local root.
ORB_DESKTOP_MCP_ENABLED=True
ORB_DESKTOP_MCP_ROOT=.runtime/rdrive_mcp_server
ORB_DESKTOP_MCP_PYTHON=python3.12
ORB_DESKTOP_MCP_TIMEOUT_SECONDS=20
ORB_DESKTOP_MCP_URL=http://127.0.0.1:8765
ORB_DESKTOP_MCP_TOKEN=

# Audit Thresholds
MIN_PAGE_SPEED_SCORE=50
MAX_TITLE_LENGTH=60
MAX_META_DESC_LENGTH=160
MIN_CONTENT_WORDS=300

# Square account integration
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_VERSION=2026-07-15
SQUARE_REDIRECT_URL=https://orbweaver.spruked.com/cart?payment=square-return
