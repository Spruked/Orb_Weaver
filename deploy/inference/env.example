# ORB Inference Gateway (the only endpoint Orb Weaver calls)
ORB_INFERENCE_GATEWAY_HOST=127.0.0.1
ORB_INFERENCE_GATEWAY_PORT=16520
ORB_INFERENCE_API_KEY=
ORB_INFERENCE_DEFAULT_LANE=universal
ORB_INFERENCE_PROVIDER_ORDER=llamacpp,aphrodite,tensorrt,ollama
ORB_INFERENCE_SCALE_THRESHOLD=3
ORB_INFERENCE_HEALTH_TTL_SECONDS=5
ORB_INFERENCE_TIMEOUT_SECONDS=60
ORB_INFERENCE_ALLOW_MODEL_OVERRIDE=false
ORB_INFERENCE_MAX_PROMPT_CHARS=24000

# Universal lane: llama.cpp / llama-server
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=auto
LLAMACPP_API_KEY=
LLAMACPP_TIMEOUT_SECONDS=60
LLAMACPP_BIN=$HOME/opt/llama.cpp/build/bin/llama-server
LLAMACPP_MODEL_PATH=$HOME/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
LLAMACPP_ALIAS=orb-local
LLAMACPP_CTX_SIZE=2048
LLAMACPP_GPU_LAYERS=99
LLAMACPP_PARALLEL=1
LLAMACPP_EXTRA_ARGS=

# Scale lane: Aphrodite Engine
APHRODITE_BASE_URL=http://127.0.0.1:2242/v1
APHRODITE_MODEL=auto
APHRODITE_API_KEY=
APHRODITE_TIMEOUT_SECONDS=60
APHRODITE_VENV=$HOME/.venvs/orb-aphrodite
APHRODITE_MODEL_ID=Qwen/Qwen3.5-0.8B
APHRODITE_GPU_MEMORY_UTILIZATION=0.72
APHRODITE_MAX_MODEL_LEN=2048
APHRODITE_MAX_NUM_SEQS=4
APHRODITE_EXTRA_ARGS=

# NVIDIA acceleration lane: TensorRT-LLM
TENSORRT_LLM_BASE_URL=http://127.0.0.1:8000/v1
TENSORRT_LLM_MODEL=auto
TENSORRT_LLM_API_KEY=
TENSORRT_LLM_TIMEOUT_SECONDS=60
TENSORRT_LLM_VENV=$HOME/.venvs/orb-tensorrt-llm
TENSORRT_LLM_MODEL_PATH=$HOME/models/tensorrt/orb-3b
TENSORRT_LLM_ENGINE_DIR=$HOME/models/tensorrt/orb-3b-engine
TENSORRT_LLM_EXTRA_ARGS=

# Existing Ollama remains a final compatibility/fallback lane.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT_SECONDS=60

# Existing Orb Weaver main backend points here, not to a provider directly.
LOCAL_LLM_URL=http://127.0.0.1:16520/api/generate
LOCAL_LLM_MODEL=orb-auto
