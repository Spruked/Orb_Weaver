# -------------------------
# Environment Files
# -------------------------
.env
.env.*
!.env.example

# Python Virtual Environments
.venv/
.venv312/
__pycache__/
*.py[cod]
*.pyo

# -------------------------
# Frontend (Node)
# -------------------------
frontend/node_modules/
frontend/build/
frontend/test-results/
frontend/*.log

# -------------------------
# Backend Logs
# -------------------------
backend/*.log

# -------------------------
# Canonical Vault Runtime Data (DO NOT COMMIT)
# -------------------------
# The root vault_system package and a-priori source are tracked. Stored client
# records, databases, learned memory, generated reports and runtime assets are
# local data and remain outside Git history.
/vault_system/clients/**
/vault_system/databases/**
/vault_system/posteriori/**
/vault_system/reports/**
/vault_system/indexes/**
/vault_system/manifests/**
/vault_system/runtime/**
/vault_system/backups/**

# Allow optional directory placeholders.
!/vault_system/clients/.gitkeep
!/vault_system/databases/.gitkeep
!/vault_system/posteriori/.gitkeep
!/vault_system/reports/.gitkeep
!/vault_system/indexes/.gitkeep
!/vault_system/manifests/.gitkeep
!/vault_system/runtime/.gitkeep
!/vault_system/backups/.gitkeep

# -------------------------
# Legacy Storage Roots (DO NOT RECREATE)
# -------------------------
# Windows-style paths accidentally interpreted as relative Linux directories.
backend/R:\R_Drive_Substrate/
backend/R:/R_Drive_Substrate/
backend/R_Drive_Substrate/
backend/**/R_Drive_Substrate/
backend/R:\\R_Drive_Substrate*/
backend/R:*/

# Old backend/substrate stores retained only until migration finalization.
backend/browser_reviews/
backend/data/
backend/vault_system/posteriori/
substrate/
data/tts_cache/

# Legacy Orb Assistant learned-memory locations.
/Orb_Assistant/.orb-assistant/
/Orb_Assistant/vault_system/posteriori/
/Orb_Assistant/src/vault_system/posteriori/
/Orb_Assistant/electron/src/vault_system/posteriori/

# Compiled report output from the legacy path.
reports/
backend/report_compiler/

# -------------------------
# Python Caches
# -------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/

# -------------------------
# Databases
# -------------------------
*.sqlite
*.db

# -------------------------
# Logs & Temp Files
# -------------------------
*.log
*.tmp

# -------------------------
# Build Artifacts
# -------------------------
dist/
build/

# -------------------------
# Node dependency folders anywhere
# -------------------------
node_modules/
**/node_modules/
tools/chrome-devtools-mcp/node_modules/

# Windows downloaded-zip metadata
*:Zone.Identifier

# Local/generated workspace snapshots and temporary backup copies
tree.txt
structure_tree_clean.txt
ORB_WEAVER_*_TREE.txt
ORB_WEAVER_*_MANIFEST.txt
frontend/src/*.before-*
frontend/src/**/*.before-*
frontend/src/*.marketplace-root-backup
frontend/src/**/*.marketplace-root-backup
