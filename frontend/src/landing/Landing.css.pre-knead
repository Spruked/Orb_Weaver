:root {
  --ow-cut-ink: #eaf7ff;
  --ow-cut-mute: #b8cad4;
  --ow-cut-cyan: #6cd7ee;
  --ow-cut-gold: #e4c567;
  --ow-cut-deep: #060d16;
  --ow-cut-night: #03070f;
}

.ow-cut-page {
  min-height: 100vh;
  position: relative;
  color: var(--ow-cut-ink);
  background:
    radial-gradient(circle at 18% 15%, rgba(108, 215, 238, 0.17), transparent 34%),
    radial-gradient(circle at 82% 35%, rgba(228, 197, 103, 0.1), transparent 28%),
    linear-gradient(140deg, var(--ow-cut-deep) 0%, var(--ow-cut-night) 100%);
  font-family: Sora, "Avenir Next", "Segoe UI", sans-serif;
}

.ow-cut-grid,
.ow-cut-noise {
  pointer-events: none;
  position: fixed;
  inset: 0;
}

.ow-cut-grid {
  opacity: 0.2;
  background-image:
    linear-gradient(rgba(108, 215, 238, 0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(108, 215, 238, 0.08) 1px, transparent 1px);
  background-size: 54px 54px;
  mask-image: radial-gradient(circle at 50% 40%, black 0%, transparent 76%);
}

.ow-cut-noise {
  opacity: 0.08;
  background-image:
    radial-gradient(circle at 15% 10%, rgba(255, 255, 255, 0.35) 0 1px, transparent 1px),
    radial-gradient(circle at 75% 25%, rgba(255, 255, 255, 0.22) 0 1px, transparent 1px);
  background-size: 92px 92px, 130px 130px;
}

.ow-cut-startup-gate {
  position: fixed;
  inset: 0;
  z-index: 2147482998;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 66% 37%, rgba(91, 200, 230, .22), transparent 31%),
    rgba(2, 8, 18, .98);
  backdrop-filter: blur(10px);
  cursor: wait;
}

.ow-cut-startup-caption {
  position: relative;
  z-index: 2;
  width: min(760px, calc(100vw - 40px));
  margin-top: 36vh;
  color: var(--ow-cut-ink);
  text-align: center;
  font-size: clamp(1.35rem, 3vw, 2.6rem);
  line-height: 1.28;
  font-weight: 700;
  letter-spacing: 0;
  text-wrap: balance;
  animation: ow-cut-startup-caption-in 500ms ease both;
}

@keyframes ow-cut-startup-caption-in {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

.ow-cut-startup-burst {
  position: absolute;
  left: 66vw;
  top: 37vh;
  width: 1px;
  height: 1px;
  pointer-events: none;
}

.ow-cut-startup-audio-status {
  position: absolute;
  z-index: 3;
  left: 66vw;
  top: calc(37vh + 154px);
  transform: translateX(-50%);
  width: min(250px, calc(100vw - 32px));
  margin: 0;
  color: rgba(236, 253, 255, .8);
  font-size: .86rem;
  letter-spacing: 0;
}

.ow-cut-startup-button {
  position: absolute;
  z-index: 3;
  left: 66vw;
  top: calc(37vh + 236px);
  transform: translateX(-50%);
  min-height: 42px;
  padding: 10px 16px;
  border: 1px solid rgba(108, 215, 238, .72);
  border-radius: 999px;
  color: #f2fcff;
  background: rgba(6, 24, 42, .9);
  box-shadow: 0 0 24px rgba(108, 215, 238, .18);
  font: inherit;
  font-size: .92rem;
  font-weight: 700;
  cursor: pointer;
}

.ow-cut-startup-button:hover,
.ow-cut-startup-button:focus-visible {
  border-color: #b9f4ff;
  background: rgba(18, 59, 84, .98);
}

@media (max-width: 720px) {
  .ow-cut-startup-burst {
    left: 50vw;
    top: 32vh;
  }

  .ow-cut-startup-audio-status {
    left: 50vw;
    top: calc(32vh + 154px);
  }

  .ow-cut-startup-button {
    left: 50vw;
    top: calc(32vh + 236px);
  }
}

.ow-cut-beat {
  position: relative;
  z-index: 2;
  min-height: 88vh;
  display: flex;
  align-items: center;
  padding: clamp(74px, 10vh, 130px) clamp(20px, 6vw, 96px);
  opacity: 0;
  transform: translateY(24px);
  transition: opacity 640ms ease, transform 640ms ease;
}

.ow-cut-beat.is-visible {
  opacity: 1;
  transform: translateY(0);
}

.ow-cut-beat + .ow-cut-beat {
  border-top: 1px solid rgba(108, 215, 238, 0.1);
}

.ow-cut-beat-hero {
  min-height: 96vh;
}

.ow-cut-beat-accent {
  background: linear-gradient(180deg, rgba(12, 26, 42, 0.45) 0%, rgba(3, 8, 16, 0.12) 100%);
}

.ow-cut-shell {
  width: min(1320px, 100%);
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(320px, 0.85fr);
  gap: clamp(28px, 5vw, 72px);
  align-items: center;
}

.ow-cut-shell-single {
  grid-template-columns: 1fr;
  max-width: 980px;
  justify-items: center;
}

.ow-cut-shell-split {
  grid-template-columns: minmax(0, 1fr) minmax(320px, 0.92fr);
  gap: clamp(42px, 7vw, 96px);
}

.ow-cut-shell-reveal,
.ow-cut-shell-technical {
  grid-template-columns: minmax(0, 0.92fr) minmax(300px, 0.88fr);
}

.ow-cut-shell-hero {
  grid-template-columns: minmax(0, 0.95fr) minmax(260px, 0.75fr);
}

.ow-cut-shell-beat2 {
  grid-template-columns: minmax(0, 1fr) minmax(280px, 0.65fr);
  gap: clamp(32px, 6vw, 88px);
  align-items: center;
}

.ow-cut-copy {
  width: min(860px, 100%);
}

.ow-cut-copy h1,
.ow-cut-copy h2,
.ow-cut-copy p {
  margin: 0;
}

.ow-cut-copy h1 {
  color: #ffffff;
  font-size: clamp(42px, 7vw, 92px);
  line-height: 0.95;
  letter-spacing: -0.045em;
}

.ow-cut-copy h1 + h1 {
  margin-top: clamp(8px, 2vh, 18px);
}

.ow-cut-copy h2 {
  margin-top: clamp(20px, 3vh, 30px);
  color: #ffffff;
  font-size: clamp(34px, 5vw, 64px);
  line-height: 1.02;
  letter-spacing: -0.03em;
}

.ow-cut-copy p {
  margin-top: 14px;
  color: var(--ow-cut-mute);
  font-size: clamp(20px, 2.2vw, 32px);
  line-height: 1.35;
  max-width: 28ch;
}

.ow-cut-copy p strong {
  color: #ffffff;
  font-weight: 800;
}

.ow-cut-copy p:first-child {
  margin-top: 0;
}

.ow-cut-strands {
  margin-top: 18px;
}

.ow-cut-strands p {
  color: #d4e6ef;
  opacity: 0;
  transform: translateX(-12px);
  animation: ow-cut-strand-in 420ms ease forwards;
}

.ow-cut-first-encounter {
  max-width: 840px;
}

.ow-cut-encounter-steps {
  display: grid;
  gap: 14px;
  margin-top: 18px;
}

.ow-cut-encounter-steps p {
  margin: 0;
  padding: 16px 18px;
  border: 1px solid rgba(108, 215, 238, 0.24);
  border-radius: 8px;
  background: rgba(6, 18, 32, 0.58);
  box-shadow: inset 0 0 24px rgba(108, 215, 238, 0.06);
}

.ow-cut-beat.is-visible .ow-cut-strands p:nth-child(1) { animation-delay: 120ms; }
.ow-cut-beat.is-visible .ow-cut-strands p:nth-child(2) { animation-delay: 220ms; }
.ow-cut-beat.is-visible .ow-cut-strands p:nth-child(3) { animation-delay: 320ms; }
.ow-cut-beat.is-visible .ow-cut-strands p:nth-child(4) { animation-delay: 420ms; }
.ow-cut-beat.is-visible .ow-cut-strands p:nth-child(5) { animation-delay: 520ms; }
.ow-cut-beat.is-visible .ow-cut-strands p:nth-child(6) { animation-delay: 620ms; }
.ow-cut-beat.is-visible .ow-cut-strands p:nth-child(7) { animation-delay: 720ms; }
.ow-cut-beat.is-visible .ow-cut-strands p:nth-child(8) { animation-delay: 820ms; }

.ow-cut-curiosity {
  width: min(980px, 100%);
  text-align: center;
}

.ow-cut-word-reveal {
  opacity: 0;
  transform: translateY(20px);
  animation: ow-cut-word-in 820ms ease forwards;
}

.ow-cut-word-reveal-delayed {
  animation-delay: 400ms;
}

.ow-cut-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 480px;
}

.ow-cut-visual-image {
  width: 100%;
  max-width: 460px;
  object-fit: contain;
  filter: drop-shadow(0 8px 36px rgba(4, 10, 22, 0.5)) drop-shadow(0 0 28px rgba(108, 215, 238, 0.14));
  animation: ow-cut-float 6s ease-in-out infinite;
}

.ow-cut-hero-visual,
.ow-cut-beat2-visual,
.ow-cut-reveal-visual,
.ow-cut-technical-visual {
  position: relative;
  min-height: 560px;
}

.ow-cut-beat2-visual {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420px;
}

.ow-cut-beat2-image {
  width: 100%;
  max-width: 420px;
  object-fit: contain;
  filter: drop-shadow(0 8px 32px rgba(4, 10, 22, 0.4)) drop-shadow(0 0 24px rgba(108, 215, 238, 0.12));
}

.ow-cut-splash-core,
.ow-cut-reveal-orb-wrap {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: min(420px, 100%);
  aspect-ratio: 1;
  margin: 0 auto;
}

.ow-cut-splash-core::after,
.ow-cut-reveal-orb-wrap::after {
  content: "";
  position: absolute;
  inset: 24%;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(8, 25, 56, 0.96) 0%, rgba(4, 12, 28, 0.94) 52%, rgba(1, 4, 12, 0) 78%);
  box-shadow:
    0 0 42px rgba(108, 215, 238, 0.22),
    inset 0 0 28px rgba(108, 215, 238, 0.08);
}

.ow-cut-splash-bloom {
  position: absolute;
  inset: 18%;
  border-radius: 999px;
  background: radial-gradient(circle, rgba(108, 215, 238, 0.68) 0%, rgba(108, 215, 238, 0.18) 38%, transparent 68%);
  filter: blur(18px);
  animation: ow-cut-bloom-pulse 5.2s ease-in-out infinite;
}

.ow-cut-splash-ring {
  position: absolute;
  inset: 9%;
  border-radius: 999px;
  border: 2px solid rgba(108, 215, 238, 0.42);
  box-shadow: 0 0 34px rgba(108, 215, 238, 0.18);
}

.ow-cut-standby-image {
  position: absolute;
  right: 0;
  top: 50%;
  width: min(400px, 92%);
  transform: translateY(-50%);
  object-fit: contain;
  filter: drop-shadow(0 8px 32px rgba(4, 10, 22, 0.5)) drop-shadow(0 0 28px rgba(108, 215, 238, 0.18));
}

.ow-cut-splash-ring-a {
  animation: ow-cut-ring-expand 4.6s ease-out infinite;
}

.ow-cut-splash-ring-b {
  inset: 18%;
  border-color: rgba(228, 197, 103, 0.36);
  animation: ow-cut-ring-expand 4.6s ease-out 0.9s infinite;
}

.ow-cut-splash-ring-c {
  inset: 28%;
  animation: ow-cut-ring-expand 4.6s ease-out 1.8s infinite;
}

.ow-cut-technical-panel {
  position: absolute;
  overflow: hidden;
  border: 1px solid rgba(108, 215, 238, 0.18);
  border-radius: 22px;
  background: rgba(7, 17, 30, 0.78);
  box-shadow: 0 24px 60px rgba(0, 0, 0, 0.28);
  backdrop-filter: blur(12px);
}

.ow-cut-technical-panel-main {
  right: 0;
  top: 24px;
  width: min(360px, 100%);
  height: 240px;
  background:
    linear-gradient(135deg, rgba(12, 33, 58, 0.88), rgba(5, 14, 28, 0.72)),
    radial-gradient(circle at 20% 30%, rgba(108, 215, 238, 0.22), transparent 36%);
}

.ow-cut-technical-panel-orb {
  left: 18px;
  bottom: 32px;
  width: 220px;
  height: 220px;
  border-radius: 999px;
  background:
    radial-gradient(circle at 34% 28%, rgba(255, 255, 255, 0.16), transparent 20%),
    radial-gradient(circle at 50% 50%, rgba(11, 30, 62, 0.96) 0%, rgba(3, 10, 24, 0.96) 58%, rgba(1, 4, 12, 0.96) 100%);
  box-shadow:
    0 0 34px rgba(108, 215, 238, 0.2),
    inset 0 0 22px rgba(108, 215, 238, 0.08);
}

.ow-cut-curiosity h1:last-of-type {
  color: var(--ow-cut-cyan);
}

.ow-cut-pause {
  margin-top: clamp(42px, 8vh, 90px);
  min-height: 48px;
}

.ow-cut-emphasis {
  margin-top: 12px;
  color: #fff2c4;
  font-weight: 700;
}

.ow-cut-preline {
  color: #ffffff;
  font-weight: 700;
}

.ow-cut-stagger {
  margin-top: 4px;
}

.ow-cut-stagger-line {
  opacity: 0;
  transform: translateY(10px);
}

.ow-cut-stagger-emphasis {
  color: var(--ow-cut-gold);
  font-weight: 700;
}

.ow-cut-beat.is-visible .ow-cut-stagger-line {
  opacity: 1;
  transform: translateY(0);
  transition: opacity 520ms ease, transform 520ms ease;
}

.ow-cut-beat.is-visible .ow-cut-stagger-line:nth-child(1) { transition-delay: 40ms; }
.ow-cut-beat.is-visible .ow-cut-stagger-line:nth-child(2) { transition-delay: 210ms; }
.ow-cut-beat.is-visible .ow-cut-stagger-line:nth-child(3) { transition-delay: 380ms; }
.ow-cut-beat.is-visible .ow-cut-stagger-line:nth-child(4) { transition-delay: 550ms; }
.ow-cut-beat.is-visible .ow-cut-stagger-line:nth-child(5) { transition-delay: 720ms; }
.ow-cut-beat.is-visible .ow-cut-stagger-line:nth-child(6) { transition-delay: 890ms; }

.ow-cut-orb-reveal {
  font-size: clamp(48px, 8vw, 124px);
  line-height: 0.9;
  text-transform: none;
}

.ow-cut-sequence {
  color: var(--ow-cut-gold);
  font-size: clamp(24px, 3.5vw, 46px);
  line-height: 1.08;
  text-transform: uppercase;
}

.ow-cut-list {
  margin: 22px 0 0;
  padding-left: 24px;
  max-width: 720px;
  color: #d4e6ef;
}

.ow-cut-list li {
  margin-top: 10px;
  font-size: clamp(17px, 1.65vw, 24px);
  line-height: 1.45;
}

.ow-cut-contrast {
  margin-top: 4px;
  display: grid;
  gap: 14px;
}

.ow-cut-contrast p {
  margin-top: 0;
  max-width: 100%;
  color: #d8e8f1;
  font-size: clamp(19px, 2.05vw, 29px);
  display: grid;
  grid-template-columns: minmax(112px, 150px) 1fr;
  align-items: baseline;
  column-gap: 14px;
}

.ow-cut-contrast span {
  color: var(--ow-cut-gold);
  font-weight: 700;
}

.ow-cut-link {
  display: inline-block;
  margin-top: 24px;
  color: var(--ow-cut-cyan);
  text-decoration: none;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.03em;
}

.ow-cut-link:hover,
.ow-cut-link:focus-visible {
  color: #ffffff;
}

.ow-cut-actions {
  margin-top: 30px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.ow-cut-primary,
.ow-cut-secondary {
  appearance: none;
  border-radius: 10px;
  padding: 14px 18px;
  font-size: 14px;
  font-weight: 800;
  text-decoration: none;
  cursor: pointer;
}

.ow-cut-primary {
  border: 0;
  color: #05212d;
  background: linear-gradient(120deg, #7fe0f4 0%, #5bc9e1 100%);
  box-shadow: 0 0 28px rgba(108, 215, 238, 0.3);
}

.ow-cut-secondary {
  border: 1px solid rgba(108, 215, 238, 0.42);
  color: #ddf5ff;
  background: rgba(7, 17, 30, 0.72);
}

.ow-cut-primary:disabled,
.ow-cut-secondary:disabled {
  opacity: 0.6;
  cursor: wait;
}

.ow-cut-secondary-links {
  margin-top: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: center;
  color: #9fb8c5;
  font-size: 13px;
}

.ow-cut-secondary-links a {
  color: #cdeaf7;
  text-decoration: none;
}

.ow-cut-secondary-links a:hover,
.ow-cut-secondary-links a:focus-visible {
  color: #ffffff;
}

.ow-cut-error {
  margin-top: 14px;
  color: #fecaca;
  font-size: 13px;
}

@keyframes ow-cut-ring-expand {
  0% {
    opacity: 0;
    transform: scale(0.2);
  }
  18% {
    opacity: 0.82;
  }
  100% {
    opacity: 0;
    transform: scale(1.42);
  }
}

@keyframes ow-cut-bloom-pulse {
  0%, 100% {
    opacity: 0.42;
    transform: scale(0.92);
  }
  50% {
    opacity: 0.88;
    transform: scale(1.08);
  }
}

@keyframes ow-cut-word-in {
  0% {
    opacity: 0;
    transform: translateY(20px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes ow-cut-strand-in {
  0% {
    opacity: 0;
    transform: translateX(-12px);
  }
  100% {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes ow-cut-float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12px);
  }
}

@media (max-width: 900px) {
  .ow-cut-shell,
  .ow-cut-shell-hero,
  .ow-cut-shell-beat2,
  .ow-cut-shell-single,
  .ow-cut-shell-split,
  .ow-cut-shell-reveal,
  .ow-cut-shell-technical {
    grid-template-columns: 1fr;
  }

  .ow-cut-beat {
    min-height: 80vh;
    padding-top: 94px;
    padding-bottom: 72px;
  }

  .ow-cut-hero-visual,
  .ow-cut-reveal-visual,
  .ow-cut-technical-visual {
    min-height: 420px;
  }

  .ow-cut-standby-image {
    position: relative;
    right: auto;
    top: auto;
    display: block;
    width: min(320px, 78vw);
    margin: 32px auto 0;
    transform: none;
  }

  .ow-cut-beat2-visual {
    min-height: 320px;
  }

  .ow-cut-beat2-image {
    max-width: min(340px, 82vw);
  }

  .ow-cut-visual {
    min-height: 360px;
  }

  .ow-cut-visual-image {
    max-width: min(360px, 84vw);
  }

  .ow-cut-technical-panel-main {
    width: min(320px, 100%);
    height: 200px;
  }

  .ow-cut-technical-panel-orb {
    width: 150px;
    height: 150px;
  }

  .ow-cut-copy p {
    max-width: 100%;
    font-size: clamp(19px, 4.7vw, 24px);
  }

  .ow-cut-contrast p {
    grid-template-columns: 1fr;
    row-gap: 2px;
  }
}

.ow-v2-pointer-bloom {
  position: fixed;
  z-index: 2147482999;
  pointer-events: none;
  border: 1px solid rgba(91, 200, 230, .66);
  border-radius: 14px;
  box-shadow:
    0 0 0 1px rgba(232, 247, 253, .28),
    0 0 22px rgba(91, 200, 230, .72),
    inset 0 0 20px rgba(91, 200, 230, .12);
  animation: ow-v2-pointer-ping 2.6s ease-out forwards;
}

.ow-v2-morb-pointer {
  position: fixed;
  z-index: 2147483001;
  width: 35px;
  height: 35px;
  border-radius: 50%;
  pointer-events: none;
  background:
    var(--ow-morb-skin),
    radial-gradient(circle at 38% 24%, rgba(255, 255, 255, .96) 0 18%, rgba(232, 246, 255, .92) 29%, rgba(75, 178, 255, .92) 44%, rgba(5, 13, 28, .98) 76%),
    radial-gradient(circle at center, rgba(2, 8, 18, .98), rgba(2, 8, 18, .98));
  background-size: cover, cover, cover;
  background-position: center;
  box-shadow:
    0 0 22px var(--ow-morb-shadow, rgba(91, 200, 230, .68)),
    0 0 48px var(--ow-morb-glow, rgba(91, 200, 230, .32)),
    inset -9px -12px 17px rgba(0, 0, 0, .62),
    inset 8px 8px 12px rgba(255, 255, 255, .32);
  opacity: 0;
  transform: translate3d(0, 0, 0) scale(.78);
  transition:
    left 620ms cubic-bezier(.22, .8, .24, 1),
    top 620ms cubic-bezier(.22, .8, .24, 1),
    opacity 180ms ease,
    transform 220ms ease;
}

.ow-v2-morb-orbit {
  position: absolute;
  inset: -17px;
  z-index: 0;
  pointer-events: none;
  border: 1px dashed rgba(109, 211, 255, .5);
  border-radius: 50%;
  box-shadow: 0 0 18px rgba(41, 142, 255, .18);
  opacity: .78;
  transition: opacity 220ms ease;
  animation: ow-v2-morb-orbit-spin 8s linear infinite;
}

.ow-v2-orb-position.has-deployed-morb .ow-v2-morb-orbit {
  opacity: .56;
}

.ow-v2-morb-orbit-dot {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(190, 241, 255, .96);
  box-shadow: 0 0 8px rgba(91, 200, 230, .86), 0 0 16px rgba(91, 200, 230, .34);
}

.ow-v2-morb-orbit-dot-one {
  top: 3px;
  left: calc(50% - 3px);
}

.ow-v2-morb-orbit-dot-two {
  right: 4px;
  bottom: 23px;
  background: rgba(224, 190, 255, .96);
  box-shadow: 0 0 8px rgba(190, 80, 255, .82), 0 0 16px rgba(190, 80, 255, .3);
}

.ow-v2-morb-orbit-dot-three {
  left: 4px;
  bottom: 23px;
  background: rgba(255, 204, 146, .96);
  box-shadow: 0 0 8px rgba(255, 141, 48, .82), 0 0 16px rgba(255, 141, 48, .3);
}

.ow-v2-morb-pointer.visible {
  opacity: 1;
  transform: translate3d(0, 0, 0) scale(1);
}

.ow-v2-morb-pointer[data-orb-pointer-phase="LAUNCH"] {
  transform: translate3d(0, 0, 0) scale(.18);
  filter: brightness(1.55);
}

.ow-v2-morb-pointer[data-orb-pointer-phase="TRAVEL"] {
  transform: translate3d(0, 0, 0) scale(1);
}

.ow-v2-morb-pointer[data-orb-pointer-phase="ARRIVAL"] {
  animation: ow-v2-morb-arrival 420ms ease-out 1;
}

.ow-v2-morb-pointer[data-orb-pointer-phase="TASK_COMPLETE"] {
  animation: ow-v2-morb-task-complete 860ms ease-out 1;
}

.ow-v2-morb-pointer.pinging {
  animation: ow-v2-morb-ping 760ms ease-out 1;
}

.ow-v2-morb-pointer.dissolving {
  opacity: 0;
  transform: translate3d(0, 0, 0) scale(1.18);
}

.ow-v2-morb-pointer::before {
  content: "";
  position: absolute;
  left: 26%;
  top: 40%;
  width: 48%;
  height: 22%;
  border-radius: 9px;
  background: rgba(2, 6, 18, .9);
  box-shadow: inset 0 0 8px rgba(0, 0, 0, .72), 0 0 10px var(--ow-morb-glow, rgba(91, 200, 230, .32));
}

.ow-v2-morb-pointer::after {
  content: "";
  position: absolute;
  left: 37%;
  top: 46%;
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: var(--ow-morb-primary, rgba(91, 200, 230, .96));
  box-shadow:
    8px 0 0 var(--ow-morb-primary, rgba(91, 200, 230, .96)),
    0 0 8px var(--ow-morb-primary, rgba(91, 200, 230, .96)),
    8px 0 8px var(--ow-morb-primary, rgba(91, 200, 230, .96));
}

.ow-v2-pointer-bloom span {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 18px;
  height: 18px;
  background: rgba(255, 244, 184, .98);
  clip-path: polygon(50% 0%, 59% 38%, 100% 50%, 59% 62%, 50% 100%, 41% 62%, 0% 50%, 41% 38%);
  box-shadow: 0 0 10px rgba(255, 244, 184, .98), 0 0 24px rgba(215, 180, 59, .9);
  transform: translate(-50%, -50%);
  animation: ow-v2-target-star 2.6s ease-out forwards;
}

.ow-v2-orb-position {
  position: absolute;
  z-index: 2147483640;
  isolation: isolate;
}

.ow-v2-orb-position.is-greeting .ow-v2-orb-body {
  animation: ow-v2-greeting-ping 1.8s ease-in-out infinite;
}

.ow-v2-orb-position.onboarding-safe-mode {
  display: none;
}

.ow-v2-local-pulse {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 1px;
  height: 1px;
  z-index: 0;
  pointer-events: none;
}

.ow-v2-local-bloom,
.ow-v2-local-ring,
.ow-v2-local-flash {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  pointer-events: none;
}

.ow-v2-local-bloom {
  width: 520px;
  height: 520px;
  margin-left: -260px;
  margin-top: -260px;
  background: radial-gradient(circle, rgba(91, 200, 230, .78) 0%, rgba(91, 200, 230, .24) 35%, transparent 68%);
  filter: blur(16px);
}

.ow-v2-local-ring {
  width: 214px;
  height: 214px;
  margin-left: -107px;
  margin-top: -107px;
  box-shadow: 0 0 40px rgba(91, 200, 230, .55);
}

.ow-v2-local-flash {
  width: 128px;
  height: 128px;
  margin-left: -64px;
  margin-top: -64px;
  background: #ffffff;
  filter: blur(9px);
}

.ow-v2-orb-body {
  position: relative;
  display: block;
  border-radius: 50%;
  border: 0;
  isolation: isolate;
  cursor: pointer;
  pointer-events: auto;
  background: radial-gradient(circle at 32% 25%, rgba(255,255,255,.98) 0%, rgba(255,248,196,.88) 9%, rgba(224,194,74,.91) 24%, rgba(154,117,26,.96) 49%, rgba(40,30,9,.98) 74%, #090905 100%);
  box-shadow:
    0 0 0 10px rgba(215,180,59,.08),
    0 0 34px rgba(215,180,59,.72),
    0 0 120px rgba(91,200,230,.22),
    inset -24px -34px 46px rgba(0,0,0,.6),
    inset 14px 12px 28px rgba(255,255,255,.4);
  overflow: visible;
}

.ow-v2-orb-body.has-image-skin {
  background: radial-gradient(circle at 50% 43%, rgba(9, 24, 46, .98) 0%, rgba(3, 10, 22, .98) 48%, rgba(1, 4, 12, .98) 74%, rgba(0, 0, 0, .98) 100%);
  box-shadow:
    0 0 0 9px rgba(2, 16, 54, .42),
    0 0 34px rgba(7, 38, 118, .82),
    0 0 118px rgba(1, 12, 54, .58),
    inset -20px -28px 44px rgba(0,0,0,.72),
    inset 10px 12px 24px rgba(75,130,215,.18);
}

.ow-v2-orb-body::before {
  content: "";
  position: absolute;
  inset: -18%;
  z-index: -1;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(8, 39, 122, .64) 0%, rgba(2, 18, 73, .48) 38%, rgba(1, 5, 20, 0) 72%);
  filter: blur(14px);
  opacity: .86;
  transform: scale(.98);
  animation: ow-v2-gold-heartbeat 3.4s ease-in-out infinite;
}

.ow-v2-orb-body:hover {
  transform: scale(1.025);
}

.ow-v2-orb-body.listening,
.ow-v2-orb-body.speaking {
  box-shadow:
    0 0 0 12px rgba(91,200,230,.13),
    0 0 42px rgba(91,200,230,.72),
    0 0 142px rgba(91,200,230,.31),
    inset -24px -34px 46px rgba(0,0,0,.6),
    inset 14px 12px 28px rgba(255,255,255,.4);
}

.ow-v2-orb-body.has-image-skin.listening,
.ow-v2-orb-body.has-image-skin.speaking {
  box-shadow:
    0 0 0 12px rgba(4, 35, 113, .36),
    0 0 54px rgba(8, 64, 168, .98),
    0 0 172px rgba(1, 12, 64, .72),
    inset -20px -28px 44px rgba(0,0,0,.72),
    inset 10px 12px 24px rgba(75,130,215,.2);
}

.ow-v2-orb-body.speaking::before {
  opacity: var(--ow-speech-core-opacity, .56);
  transform: scale(var(--ow-speech-core-scale, .98));
  animation: none;
}

.ow-v2-orb-skin-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  border-radius: 50%;
  user-select: none;
  pointer-events: none;
  z-index: 1;
  filter: saturate(1.12) contrast(1.12) brightness(1.12) drop-shadow(0 18px 22px rgba(0,0,0,.44));
}

.ow-v2-orb-core-pulse {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 49%;
  height: 49%;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  z-index: 4;
  overflow: hidden;
  background: radial-gradient(circle at 48% 47%, rgba(11, 75, 190, .96) 0%, rgba(3, 34, 112, .98) 43%, rgba(1, 12, 52, .99) 72%, rgba(0, 4, 24, .96) 100%);
  box-shadow:
    0 0 18px rgba(38, 143, 255, .58),
    inset 0 0 0 4px rgba(0, 3, 22, .88),
    inset 0 0 24px rgba(0, 2, 22, .92),
    inset 0 8px 16px rgba(124, 222, 255, .22);
  opacity: .98;
  pointer-events: none;
  animation: ow-v2-core-drift 37s ease-in-out infinite;
}

.ow-v2-orb-core-recess {
  position: absolute;
  inset: 5%;
  z-index: 0;
  border-radius: 50%;
  background: radial-gradient(ellipse at 45% 42%, rgba(106, 206, 255, .72) 0 3%, rgba(16, 107, 244, .68) 16%, rgba(2, 29, 115, .92) 46%, rgba(0, 5, 34, .98) 73%);
  box-shadow: inset 0 0 0 3px rgba(117, 218, 255, .18), inset 8px 12px 18px rgba(0, 0, 16, .9), inset -8px -9px 18px rgba(70, 176, 255, .24);
}

.ow-v2-orb-core-fold {
  position: absolute;
  inset: -16%;
  z-index: 1;
  border-radius: 48% 52% 54% 46%;
  pointer-events: none;
  mix-blend-mode: screen;
  filter: blur(3px);
  will-change: transform, opacity;
}

.ow-v2-orb-core-fold-one {
  background: conic-gradient(from 18deg, transparent 0 9%, rgba(246, 255, 255, .95) 18%, rgba(112, 210, 255, .5) 29%, transparent 43% 61%, rgba(37, 132, 255, .58) 75%, rgba(223, 249, 255, .82) 85%, transparent 96% 100%);
  animation: ow-v2-core-fold-in-one 3.6s cubic-bezier(.42, 0, .28, 1) infinite;
}

.ow-v2-orb-core-fold-two {
  inset: -7%;
  background: conic-gradient(from 198deg, transparent 0 12%, rgba(220, 250, 255, .82) 24%, rgba(21, 105, 247, .55) 39%, transparent 53% 69%, rgba(178, 235, 255, .88) 82%, transparent 94% 100%);
  animation: ow-v2-core-fold-in-two 4.3s cubic-bezier(.42, 0, .28, 1) infinite;
}

.ow-v2-orb-core-fold-three {
  inset: 14%;
  z-index: 2;
  background: radial-gradient(ellipse at 38% 34%, rgba(255, 255, 255, .98) 0 10%, rgba(172, 231, 255, .8) 22%, rgba(28, 128, 255, .38) 48%, transparent 70%);
  filter: blur(1px);
  animation: ow-v2-core-heart 1.8s ease-in-out infinite;
}

.ow-v2-orb-core-nucleus {
  position: absolute;
  inset: 31%;
  z-index: 4;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 35%, #ffffff 0 9%, rgba(219, 251, 255, .98) 22%, rgba(82, 188, 255, .8) 51%, rgba(7, 67, 197, .28) 72%, transparent 78%);
  box-shadow: 0 0 10px rgba(229, 252, 255, .95), 0 0 22px rgba(38, 149, 255, .72), inset -4px -5px 8px rgba(2, 30, 117, .64);
  animation: ow-v2-core-nucleus-depth 2.65s cubic-bezier(.42, 0, .24, 1) infinite;
}

.ow-v2-orb-core-pulse::before,
.ow-v2-orb-core-pulse::after {
  content: "";
  position: absolute;
  inset: 9%;
  border-radius: 50%;
  pointer-events: none;
}

.ow-v2-orb-core-pulse::before {
  z-index: 2;
  background: conic-gradient(
    from 12deg,
    transparent 0 12%,
    rgba(173, 235, 255, .46) 22%,
    rgba(23, 124, 255, .08) 38%,
    rgba(136, 221, 255, .34) 56%,
    transparent 72% 100%
  );
  filter: blur(4px);
  mix-blend-mode: screen;
  animation: ow-v2-core-current 44s ease-in-out infinite;
}

.ow-v2-orb-core-pulse::after {
  z-index: 3;
  inset: 20%;
  background: radial-gradient(circle, rgba(221, 255, 249, .42), rgba(68, 174, 255, .12) 54%, transparent 72%);
  filter: blur(3px);
  animation: ow-v2-core-current 32s ease-in-out infinite reverse;
}

.ow-v2-orb-body.listening .ow-v2-orb-core-pulse {
  opacity: .76;
  animation-duration: 21s;
}

.ow-v2-orb-body.speaking .ow-v2-orb-core-pulse {
  opacity: var(--ow-speech-core-opacity, .72);
  background: radial-gradient(circle, rgba(250, 255, 255, .98) 0%, rgba(174, 230, 255, .9) 18%, rgba(37, 136, 255, .7) 45%, rgba(6, 62, 196, .26) 68%, transparent 76%);
  box-shadow:
    0 0 20px rgba(205, 247, 255, .96),
    0 0 54px rgba(28, 126, 255, .8),
    inset 0 0 22px rgba(236, 252, 255, .84);
  animation: ow-v2-speaking-core 780ms ease-in-out infinite;
}

.ow-v2-orb-body.speaking .ow-v2-orb-core-pulse::before,
.ow-v2-orb-body.speaking .ow-v2-orb-core-pulse::after {
  background: radial-gradient(circle, rgba(255, 255, 255, .96), rgba(158, 225, 255, .72) 36%, rgba(28, 126, 255, .18) 67%, transparent 78%);
  box-shadow: 0 0 20px rgba(115, 208, 255, .9);
}

.ow-v2-orb-body.speaking .ow-v2-orb-core-pulse::before {
  animation: ow-v2-speaking-current 1.16s linear infinite;
}

.ow-v2-orb-body.speaking .ow-v2-orb-core-pulse::after {
  animation: ow-v2-speaking-white-bloom .62s ease-in-out infinite;
}

@keyframes ow-v2-core-drift {
  0%, 100% { transform: translate(-50%, -50%) scale(.95); }
  38% { transform: translate(-48%, -52%) scale(1.05); }
  68% { transform: translate(-52%, -48%) scale(.98); }
}

@keyframes ow-v2-core-fold-in-one {
  0%, 100% { transform: rotate(0deg) scale(1.16) skewX(-7deg); opacity: .4; }
  42% { transform: rotate(144deg) scale(.52) skewX(8deg); opacity: 1; }
  64% { transform: rotate(222deg) scale(.77) skewX(-4deg); opacity: .8; }
}

@keyframes ow-v2-core-fold-in-two {
  0%, 100% { transform: rotate(0deg) scale(.5) skewY(5deg); opacity: .92; }
  48% { transform: rotate(-168deg) scale(1.18) skewY(-7deg); opacity: .42; }
  72% { transform: rotate(-238deg) scale(.72) skewY(4deg); opacity: .85; }
}

@keyframes ow-v2-core-heart {
  0%, 100% { transform: scale(.68) rotate(0deg); opacity: .56; }
  45% { transform: scale(1.2) rotate(34deg); opacity: 1; }
  72% { transform: scale(.84) rotate(64deg); opacity: .82; }
}

@keyframes ow-v2-core-nucleus-depth {
  0%, 100% { transform: translate(-4%, -3%) scale(.64); opacity: .58; }
  38% { transform: translate(6%, 5%) scale(1.18); opacity: 1; }
  65% { transform: translate(-1%, 3%) scale(.82); opacity: .8; }
}

@keyframes ow-v2-core-current {
  from { transform: rotate(0deg) scale(.92); }
  50% { transform: rotate(180deg) scale(1.08); }
  to { transform: rotate(360deg) scale(.92); }
}

@keyframes ow-v2-speaking-core {
  0%, 100% { transform: translate(-50%, -50%) scale(.94); filter: brightness(1); }
  42% { transform: translate(calc(-50% + 2px), calc(-50% - 2px)) scale(1.13); filter: brightness(1.28); }
  70% { transform: translate(calc(-50% - 2px), calc(-50% + 1px)) scale(1.02); filter: brightness(1.08); }
}

@keyframes ow-v2-speaking-current {
  from { transform: rotate(0deg) scale(.82); opacity: .68; }
  50% { transform: rotate(180deg) scale(1.13); opacity: 1; }
  to { transform: rotate(360deg) scale(.82); opacity: .68; }
}

@keyframes ow-v2-speaking-white-bloom {
  0%, 100% { transform: scale(.72); opacity: .58; }
  46% { transform: scale(1.34); opacity: 1; }
  68% { transform: scale(.94); opacity: .78; }
}

.ow-v2-orb-body.has-image-skin.thinking::after {
  opacity: .82;
  animation: ow-v2-blue-pulse-ring 2.1s ease-in-out infinite;
}

.ow-v2-deploy-effect {
  position: absolute;
  inset: -24%;
  z-index: -1;
  border-radius: 50%;
  pointer-events: none;
  animation: ow-v2-orbit-spin 12s linear infinite;
}

.ow-v2-deploy-effect::before {
  display: none;
  content: none;
}

.ow-v2-orb-position.is-pointing .ow-v2-deploy-effect {
  animation-duration: 3.2s;
}

.ow-v2-orb-position.is-pointing .ow-v2-deploy-effect::before {
  content: "";
  display: block;
  position: absolute;
  left: 50%;
  top: 50%;
  width: min(42vw, 520px);
  height: 22px;
  transform-origin: left center;
  transform: rotate(calc(var(--ow-pointer-angle) - 0deg));
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(215, 180, 59, .7), rgba(91, 200, 230, .3), transparent 92%);
  filter: blur(7px);
  opacity: 0;
  animation: ow-v2-pointer-origin 2.6s ease-in-out forwards;
}

.ow-v2-deploy-effect::after {
  content: "";
  position: absolute;
  top: 45%;
  right: 55%;
  width: 180%;
  height: 18%;
  transform: translateY(-50%) rotate(-8deg);
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, rgba(91, 220, 255, .16), rgba(255, 232, 126, .34), transparent);
  filter: blur(12px);
  opacity: .36;
  animation: ow-v2-stage-trail 7.4s ease-in-out infinite;
}

.ow-v2-deploy-effect span {
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: rgba(17, 76, 172, .86);
  box-shadow: 0 0 14px rgba(12, 72, 184, .72), 0 0 34px rgba(3, 20, 84, .42);
}

.ow-v2-deploy-effect span:nth-child(1) {
  left: 50%;
  top: 0;
  transform: translate(-50%, -50%);
}

.ow-v2-deploy-effect span:nth-child(2) {
  right: 4%;
  top: 72%;
  transform: translate(50%, -50%);
  opacity: .72;
}

.ow-v2-deploy-effect span:nth-child(3) {
  left: 6%;
  top: 70%;
  transform: translate(-50%, -50%);
  opacity: .58;
}

.ow-v2-orb-speaker {
  position: absolute;
  right: -4px;
  bottom: -8px;
  z-index: 8;
  display: inline-flex;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(91,200,230,.42);
  border-radius: 999px;
  background: rgba(3, 10, 22, .92);
  color: rgba(232, 247, 253, .9);
  box-shadow: 0 12px 30px rgba(0,0,0,.34), 0 0 22px rgba(91,200,230,.18);
  cursor: pointer;
  pointer-events: auto;
  transition: transform .16s ease, background .16s ease, color .16s ease;
}

.ow-v2-orb-speaker:hover {
  transform: scale(1.06);
  color: #ffffff;
}

.ow-v2-orb-speaker.active {
  border-color: rgba(215,180,59,.74);
  background: rgba(61, 46, 7, .94);
  color: #fff3b0;
  box-shadow: 0 12px 30px rgba(0,0,0,.34), 0 0 24px rgba(215,180,59,.36);
}

.ow-v2-orb-speech {
  position: fixed;
  right: clamp(12px, 4vw, 28px);
  top: clamp(92px, 15vh, 160px);
  width: min(360px, calc(100vw - 24px));
  max-height: min(280px, 52vh);
  overflow: hidden;
  border: 1px solid rgba(91,200,230,.24);
  border-radius: 14px;
  padding: 11px 13px;
  background: rgba(4, 14, 24, .86);
  color: rgba(236, 253, 255, .96);
  font-size: 13px;
  line-height: 1.42;
  text-align: left;
  box-shadow: 0 18px 48px rgba(0,0,0,.28);
  pointer-events: none;
}

.ow-v2-orb-speech span {
  position: relative;
  z-index: 1;
  display: block;
  color: rgba(236, 253, 255, .96);
  white-space: pre-line;
}

.ow-v2-startup-panel {
  position: fixed;
  right: 14px;
  bottom: 14px;
  z-index: 2147483002;
  width: min(360px, calc(100vw - 28px));
  max-height: min(420px, calc(100vh - 28px));
  overflow: auto;
  border: 1px solid rgba(91,200,230,.28);
  border-radius: 14px;
  padding: 12px 14px;
  background: rgba(3, 11, 20, .92);
  color: rgba(236, 253, 255, .96);
  box-shadow: 0 18px 48px rgba(0,0,0,.32);
}

.ow-v2-startup-panel strong {
  display: block;
  font-size: 13px;
}

.ow-v2-startup-panel p {
  margin: 4px 0 0;
  color: rgba(184, 202, 212, .86);
  font-size: 12px;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.ow-v2-startup-diagnostics {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 5px 10px;
  margin: 9px 0 0;
  font-size: 11px;
}

.ow-v2-startup-diagnostics div {
  min-width: 0;
}

.ow-v2-startup-diagnostics dt {
  color: rgba(184, 202, 212, .78);
  font-weight: 700;
}

.ow-v2-startup-diagnostics dd {
  margin: 1px 0 0;
  color: rgba(236, 253, 255, .96);
  overflow-wrap: anywhere;
}

.ow-v2-startup-reset {
  position: relative;
  z-index: 1;
  margin-top: 10px;
  border: 1px solid rgba(91, 200, 230, .34);
  border-radius: 999px;
  padding: 7px 10px;
  background: rgba(8, 25, 42, .9);
  color: rgba(236, 253, 255, .94);
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0;
  pointer-events: auto;
  cursor: pointer;
}

.ow-v2-startup-reset:hover {
  border-color: rgba(215, 180, 59, .62);
}

.ow-v2-diagnostic-utterance {
  margin: 10px 0 0;
  border-top: 1px solid rgba(91, 200, 230, .18);
  padding-top: 9px;
  color: rgba(236, 253, 255, .9);
  font-size: 12px;
  line-height: 1.4;
}

@media (max-width: 900px) {
  .ow-v2-orb-speech {
    left: 12px;
    right: 12px;
    top: 86px;
    width: auto;
    transform: none;
    text-align: center;
  }

  .ow-v2-orb-speaker {
    right: -2px;
    bottom: -4px;
  }
}

@keyframes ow-v2-pointer-ping {
  0% { opacity: 0; transform: scale(.94); }
  18% { opacity: .42; transform: scale(.98); }
  46% { opacity: .92; transform: scale(1); }
  72% { opacity: .48; transform: scale(1.015); }
  100% { opacity: 0; transform: scale(1.05); }
}

@keyframes ow-v2-target-star {
  0%, 22% { opacity: 0; transform: translate(-50%, -50%) scale(.15) rotate(0deg); }
  44% { opacity: 1; transform: translate(-50%, -50%) scale(1.25) rotate(24deg); }
  62% { opacity: .94; transform: translate(-50%, -50%) scale(.88) rotate(42deg); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(.35) rotate(70deg); }
}

@keyframes ow-v2-pointer-origin {
  0% { opacity: .18; height: 12px; filter: brightness(1); }
  24% { opacity: .58; height: 18px; filter: brightness(1.28); }
  44% { opacity: .94; height: 24px; filter: brightness(1.7); }
  66% { opacity: .52; height: 17px; filter: brightness(1.18); }
  100% { opacity: 0; height: 12px; filter: brightness(1); }
}

@keyframes ow-v2-morb-ping {
  0% { filter: brightness(1); box-shadow: 0 0 8px var(--ow-morb-shadow, rgba(91, 200, 230, .68)), 0 0 14px var(--ow-morb-glow, rgba(91, 200, 230, .32)); }
  42% { filter: brightness(1.34); box-shadow: 0 0 12px var(--ow-morb-shadow, rgba(91, 200, 230, .82)), 0 0 24px var(--ow-morb-glow, rgba(91, 200, 230, .44)); }
  100% { filter: brightness(1); box-shadow: 0 0 9px var(--ow-morb-shadow, rgba(91, 200, 230, .68)), 0 0 16px var(--ow-morb-glow, rgba(91, 200, 230, .32)); }
}

@keyframes ow-v2-morb-arrival {
  0% { transform: translate3d(0, 0, 0) scale(.92); }
  55% { transform: translate3d(0, 0, 0) scale(1.08); }
  100% { transform: translate3d(0, 0, 0) scale(1); }
}

@keyframes ow-v2-morb-task-complete {
  0%, 100% { filter: brightness(1); }
  35% { filter: brightness(1.6); }
  60% { filter: brightness(1.15); }
}

@keyframes ow-v2-morb-orbit-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes ow-v2-gold-heartbeat {
  0%, 100% { opacity: .5; transform: scale(.92); box-shadow: 0 0 18px rgba(15, 89, 166, .28); }
  14% { opacity: .92; transform: scale(1.04); box-shadow: 0 0 46px rgba(30, 126, 218, .68); }
  24% { opacity: .64; transform: scale(.98); box-shadow: 0 0 28px rgba(17, 94, 171, .42); }
  38% { opacity: .84; transform: scale(1.02); box-shadow: 0 0 38px rgba(22, 116, 211, .56); }
  58% { opacity: .52; transform: scale(.94); box-shadow: 0 0 18px rgba(15, 89, 166, .28); }
}

@keyframes ow-v2-blue-pulse-ring {
  0%, 100% { opacity: .34; transform: scale(.96); }
  45% { opacity: .82; transform: scale(1.08); }
  62% { opacity: .44; transform: scale(1.18); }
}

@keyframes ow-v2-greeting-ping {
  0%, 100% { filter: brightness(1); transform: scale(1); }
  35% { filter: brightness(1.28); transform: scale(1.035); }
  62% { filter: brightness(1.05); transform: scale(1); }
}

@keyframes ow-v2-greeting-logo-ping {
  0%, 100% { opacity: .72; transform: scale(.88); }
  42% { opacity: 1; transform: scale(1.08); }
  70% { opacity: .84; transform: scale(.98); }
}

@keyframes ow-v2-orbit-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes ow-v2-eye-idle {
  0%, 100% { transform: translate(-50%, -50%) scale(.92); opacity: .82; }
  35% { transform: translate(calc(-50% + 3px), calc(-50% - 2px)) scale(1); opacity: .96; }
  68% { transform: translate(calc(-50% - 2px), calc(-50% + 2px)) scale(.95); opacity: .88; }
}

@keyframes ow-v2-eye-speaking {
  0%, 100% {
    transform: translate(-50%, -50%) scale(.92);
    box-shadow: 0 0 0 4px rgba(0, 4, 10, .9), 0 0 14px rgba(42, 246, 255, .62), 0 0 28px rgba(42, 246, 255, .34), inset 0 0 12px rgba(42, 246, 255, .32);
  }
  34% {
    transform: translate(calc(-50% + 4px), calc(-50% - 2px)) scale(1.12);
    box-shadow: 0 0 0 4px rgba(0, 4, 10, .9), 0 0 22px rgba(42, 246, 255, .86), 0 0 50px rgba(42, 246, 255, .52), inset 0 0 18px rgba(42, 246, 255, .48);
  }
  68% {
    transform: translate(calc(-50% - 3px), calc(-50% + 3px)) scale(1.03);
    box-shadow: 0 0 0 4px rgba(0, 4, 10, .9), 0 0 18px rgba(42, 246, 255, .76), 0 0 38px rgba(42, 246, 255, .42), inset 0 0 15px rgba(42, 246, 255, .42);
  }
}

@keyframes ow-v2-stage-trail {
  0%, 100% { opacity: .18; transform: translate(18%, -50%) rotate(-8deg) scaleX(.72); }
  18% { opacity: .72; transform: translate(-8%, -50%) rotate(-6deg) scaleX(1.08); }
  42% { opacity: .26; transform: translate(-18%, -50%) rotate(-10deg) scaleX(.9); }
}
